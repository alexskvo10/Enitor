{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enitor webhook event",
  "description": "The body of a webhook POST (formats.md, section 3). Sent only for things the user did on this device. The data shape depends on type. id is a hash of the record id, the type and the format version, so a repeat of the same fact has the same id. $defs/Task is a copy of task.schema.json; a test keeps the two equal.",
  "type": "object",
  "required": ["v", "id", "type", "createdAt", "data"],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1,
      "description": "Format version."
    },
    "id": {
      "type": "string",
      "pattern": "^evt_",
      "description": "Event id, evt_ followed by a hash. Use it to drop duplicates."
    },
    "type": {
      "type": "string",
      "enum": ["task.completed", "day.closed", "goal.achieved", "ping"],
      "description": "Event type. Selects the data shape below."
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Time of the event, ISO 8601 with the device's UTC offset, for example 2026-11-02T18:31:05.120+03:00."
    },
    "data": {
      "type": "object",
      "description": "Payload. Its shape is set by type."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "task.completed" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["task"],
            "additionalProperties": false,
            "properties": {
              "task": { "$ref": "#/$defs/Task" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "day.closed" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["date", "done", "total", "productivity"],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                "description": "The closed day, YYYY-MM-DD."
              },
              "done": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of finished tasks of the day."
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of tasks of the day, not counting moved-away originals."
              },
              "productivity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Share of finished tasks, 0 to 100. Sent only when every task of the day is done, so it is 100 in practice."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "goal.achieved" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["goal"],
            "additionalProperties": false,
            "properties": {
              "goal": {
                "type": "object",
                "required": ["id", "title", "period", "progress"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "period": {
                    "type": "string",
                    "enum": ["week", "month", "season", "year"]
                  },
                  "target": {
                    "type": "integer",
                    "description": "Target count. Present only for a counter goal."
                  },
                  "progress": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "ping" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        }
      }
    }
  ],
  "$defs": {
    "Task": {
      "type": "object",
      "description": "A task as in task.schema.json.",
      "required": ["id", "title", "date", "priority", "tags", "done"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Task id. Use it with complete_task, either in full or as a unique prefix."
        },
        "title": { "type": "string", "minLength": 1 },
        "description": {
          "type": "string",
          "description": "Present only when the task has a description."
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "Day of the task, YYYY-MM-DD."
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Start time, HH:MM. Present only for timed tasks."
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "End time, HH:MM. Present only when the task has one."
        },
        "priority": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "done": {
          "type": "boolean",
          "description": "true when the task is completed (for a counter or a checklist: when it reaches the target)."
        }
      }
    }
  }
}
